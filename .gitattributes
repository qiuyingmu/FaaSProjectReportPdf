# 统一换行符：仓库内统一存 LF，消除 git status 的 CRLF 噪音
* text=auto

# 源码类文件强制 LF（避免 Windows 下 CRLF 噪音）
*.java text eol=lf
*.vue   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.properties text eol=lf

# 二进制文件不做转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ttc   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.jar   binary
*.zip   binary
*.gz    binary
*.pdf   binary
*.exe   binary
*.map   binary
